# Copy this file to .env and fill in real values. .env is never committed.

# Where the raw CSV lives
RAW_DATA_PATH=data/raw/sales_clean.csv

# SQLite database the pipeline writes to
DB_PATH=data/processed/sales.db

# Validation thresholds
MIN_UNIT_PRICE=0
MAX_DISCOUNT_PCT=50
MIN_QUANTITY=1

# Log file
LOG_PATH=pipeline.log
